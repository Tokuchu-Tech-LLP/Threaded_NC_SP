/*
 * Dedicated Nurse Call (NC Only) Overlay
 * Restored Original GPIO Pin Assignments:
 *   Light LED - P0.02 (Active High)
 *   Call      - P0.03 (Pull-Up, Active Low)
 *   Blue      - P1.15 (Pull-Up, Active Low)
 *   Cancel    - P1.13 (Pull-Up, Active Low)
 *   Config    - P1.06 (Pull-Up, Active Low)
 *   Motion    - P1.10 (Pull-Down, Active High)
 *   OT LED    - P0.05 (Active Low)
 *   Relay     - P1.11 (Active High)
 */

/ {
	chosen {
		zephyr,entropy = &rng;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {				// OpenThread LED
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			label = "Green LED 0";
		};
		// SpO2 Red & IR LEDs disabled to free P1.13 and P1.15 for Cancel & Blue buttons
		// led1: led_1 {
		// 	gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		// 	label = "Red LED 1";
		// };
		// led2: led_2 {
		// 	gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		// 	label = "Green LED 1";
		// };
		// led3: led_3 {
		// 	gpios = <&gpio0 16 GPIO_ACTIVE_LOW>; // Not used
		// 	label = "Blue LED 1";
		// };
		led4S: led_4 {			// LIGHT_LED
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;  // Original Nurse Call Light LED: P0.02 Active High
			label = "LED";
		};
		led5S: led_5 {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;  // Relay control
			label = "LED 5";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // Device Config Parameters and Provisioning
			label = "Push button switch 0";
		};

		button1: button_1 {
			gpios = <&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  // 3rd Button - Cancel (P1.13)
			label = "Push button switch 1";
		};

		button2: button_2 {
			gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;   // 2nd Button - Blue (P1.15)
			label = "Push button switch 2";
		};

		button3: button_3 {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;   // 1st Button - Call (P0.03)
			label = "Push button switch 3";
		};

		button4: button_4 {
			gpios = <&gpio1 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;  // 4th Button - Motion Sensor PULL DOWN and ACTIVE HIGH
			label = "Push button switch 4";
		};
	};
};

&adc {
	status = "okay";
};

&uart1 {
	status = "disabled";
};

&pwm0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

&qspi {
	status = "disabled";
};

&usbd {
	status = "disabled";
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 21)>,
				<NRF_PSEL(UART_RTS, 0, 20)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 23)>,
				<NRF_PSEL(UART_CTS, 0, 22)>;
			bias-pull-up;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 21)>,
				<NRF_PSEL(UART_RX, 0, 23)>,
				<NRF_PSEL(UART_RTS, 0, 20)>,
				<NRF_PSEL(UART_CTS, 0, 22)>;
			low-power-enable;
		};
	};

	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>;
			bias-pull-up;
		};
		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_TX, 1, 2)>;
			low-power-enable;
		};
	};
};
